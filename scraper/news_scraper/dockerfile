FROM python:3.12-slim

WORKDIR /app

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copier les requirements
COPY news_scraper/requirements.txt /app/news_scraper/requirements.txt

# Installer les dépendances Python
RUN pip install --no-cache-dir -r news_scraper/requirements.txt

# Copier le code du scraper
COPY news_scraper/ /app/news_scraper/

# Copier le .env (sera écrasé par env_file dans docker-compose)
COPY .env /app/.env

# Variable d'environnement pour Python
ENV PYTHONUNBUFFERED=1

# Point d'entrée
CMD ["python", "news_scraper/main.py"]